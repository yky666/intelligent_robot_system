<launch>
  <arg name="robot_ns" default="tb1" />
  <arg name="base_frame" default="$(arg robot_ns)/base_footprint" />
  <arg name="marker_id" default="1" />
  <arg name="follow_distance" default="1.0" />
  <arg name="scan_topic" default="/$(arg robot_ns)/scan" />
  <arg name="cmd_vel_topic" default="/$(arg robot_ns)/cmd_vel_mux/input/navi" />
  <group ns="$(eval arg('robot_ns') or '/')">
    <node pkg="multi_robot_following" type="marker_follower.py" name="marker_follower" output="screen">
      <param name="marker_id" value="$(arg marker_id)" />
      <param name="base_frame" value="$(arg base_frame)" />
      <param name="follow_distance" value="$(arg follow_distance)" />
    </node>
    <node pkg="multi_robot_following" type="velocity_gate.py" name="velocity_gate" output="screen">
      <remap from="scan" to="$(arg scan_topic)" />
      <remap from="cmd_vel_safe" to="$(arg cmd_vel_topic)" />
    </node>
  </group>
</launch>
