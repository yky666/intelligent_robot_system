<launch>
  <!-- Single course Turtlebot: unprefixed driver TF/topics by default. -->
  <arg name="map_file" />
  <arg name="robot_ns" default="" />
  <arg name="map_frame" default="map" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="odom_frame" default="odom" />
  <arg name="scan_topic" default="/scan" />
  <arg name="cmd_vel_topic" default="/cmd_vel_mux/input/navi" />
  <arg name="target_source" default="marker" />
  <arg name="leader_pose_topic" default="/tb1/amcl_pose" />
  <arg name="marker_topic" default="/ar_pose_marker" />
  <arg name="marker_id" default="1" />
  <arg name="follow_distance" default="0.9" />
  <arg name="start_ar_tracker" default="$(eval arg('target_source') == 'marker')" />
  <arg name="image_topic" default="/camera/rgb/image_raw" />
  <arg name="info_topic" default="/camera/rgb/camera_info" />
  <arg name="optical_frame" default="camera_rgb_optical_frame" />
  <arg name="marker_size_cm" default="9.0" />
  <include file="$(find multi_robot_following)/launch/navigation.launch">
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="odom_frame" value="$(arg odom_frame)" />
    <arg name="scan_topic" value="$(arg scan_topic)" />
  </include>
  <include file="$(find multi_robot_following)/launch/follow_map.launch">
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="scan_topic" value="$(arg scan_topic)" />
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <arg name="target_source" value="$(arg target_source)" />
    <arg name="leader_pose_topic" value="$(arg leader_pose_topic)" />
    <arg name="marker_topic" value="$(arg marker_topic)" />
    <arg name="marker_id" value="$(arg marker_id)" />
    <arg name="follow_distance" value="$(arg follow_distance)" />
  </include>
  <include if="$(arg start_ar_tracker)" file="$(find multi_robot_following)/launch/ar_tracker.launch">
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="info_topic" value="$(arg info_topic)" />
    <arg name="optical_frame" value="$(arg optical_frame)" />
    <arg name="marker_size_cm" value="$(arg marker_size_cm)" />
  </include>
</launch>
