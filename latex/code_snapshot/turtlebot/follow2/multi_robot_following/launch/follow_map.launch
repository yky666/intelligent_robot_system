<launch>
  <arg name="robot_ns" default="tb2" />
  <arg name="map_frame" default="map" />
  <arg name="base_frame" default="$(arg robot_ns)/base_footprint" />
  <!-- marker follows TonyPi; pose follows a predecessor already localized in map. -->
  <arg name="target_source" default="marker" />
  <arg name="marker_id" default="1" />
  <arg name="leader_pose_topic" default="/tb1/amcl_pose" />
  <arg name="marker_topic" default="/$(arg robot_ns)/ar_pose_marker" />
  <arg name="follow_distance" default="0.9" />
  <arg name="scan_topic" default="/$(arg robot_ns)/scan" />
  <arg name="cmd_vel_topic" default="/$(arg robot_ns)/cmd_vel_mux/input/navi" />
  <group ns="$(eval arg('robot_ns') or '/')">
    <node if="$(eval arg('target_source') == 'marker')" pkg="multi_robot_following" type="marker_target.py" name="marker_target" output="screen">
      <param name="marker_id" value="$(arg marker_id)" />
      <param name="map_frame" value="$(arg map_frame)" />
      <remap from="ar_pose_marker" to="$(arg marker_topic)" />
    </node>
    <node if="$(eval arg('target_source') == 'pose')" pkg="multi_robot_following" type="pose_relay.py" name="pose_relay" output="screen">
      <param name="map_frame" value="$(arg map_frame)" />
      <remap from="leader_pose" to="$(arg leader_pose_topic)" />
    </node>
    <node pkg="multi_robot_following" type="map_follower.py" name="map_follower" output="screen">
      <param name="map_frame" value="$(arg map_frame)" />
      <param name="base_frame" value="$(arg base_frame)" />
      <param name="follow_distance" value="$(arg follow_distance)" />
    </node>
    <node pkg="multi_robot_following" type="velocity_gate.py" name="velocity_gate" output="screen">
      <remap from="scan" to="$(arg scan_topic)" />
      <remap from="cmd_vel_safe" to="$(arg cmd_vel_topic)" />
    </node>
  </group>
</launch>
