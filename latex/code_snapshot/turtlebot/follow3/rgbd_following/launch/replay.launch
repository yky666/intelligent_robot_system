<launch>
  <!-- Run on an isolated ROS master, with no hardware drivers. Input topics only. -->
  <arg name="bag" />
  <arg name="settings" default="$(find rgbd_following)/config/follow.yaml" />
  <arg name="robot_ns" default="replay_tb3" />
  <arg name="odom_topic" default="/odom" />
  <arg name="odom_frame" default="odom" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="rgb_topic" default="/camera/rgb/image_rect_color" />
  <arg name="depth_topic" default="/camera/depth_registered/image_rect" />
  <arg name="info_topic" default="/camera/rgb/camera_info" />
  <arg name="mission_topic" default="/competition/mission" />
  <arg name="estop_topic" default="/competition/estop" />
  <param name="use_sim_time" value="true" />
  <include file="$(find rgbd_following)/launch/follow.launch">
    <arg name="execute" value="false" />
    <arg name="settings" value="$(arg settings)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="odom_frame" value="$(arg odom_frame)" />
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="rgb_topic" value="$(arg rgb_topic)" />
    <arg name="depth_topic" value="$(arg depth_topic)" />
    <arg name="info_topic" value="$(arg info_topic)" />
    <arg name="mission_topic" value="$(arg mission_topic)" />
    <arg name="estop_topic" value="$(arg estop_topic)" />
  </include>
  <node pkg="rosbag" type="play" name="rgbd_bag_replay" output="screen" required="true"
        args="--clock --pause --rate 1.0 &quot;$(arg bag)&quot; --topics $(arg rgb_topic) $(arg depth_topic) $(arg info_topic) $(arg odom_topic) /tf /tf_static $(arg mission_topic) $(arg estop_topic)" />
</launch>
