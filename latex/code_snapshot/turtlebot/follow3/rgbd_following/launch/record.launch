<launch>
  <arg name="robot_ns" default="tb3" />
  <arg name="scenario" />
  <arg name="output" />
  <arg name="bag_prefix" />
  <arg name="revision" default="unspecified" />
  <arg name="settings" default="$(find rgbd_following)/config/follow.yaml" />
  <arg name="odom_topic" default="/odom" />
  <arg name="odom_frame" default="odom" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="rgb_topic" default="/camera/rgb/image_rect_color" />
  <arg name="depth_topic" default="/camera/depth_registered/image_rect" />
  <arg name="info_topic" default="/camera/rgb/camera_info" />
  <arg name="mission_topic" default="/competition/mission" />
  <arg name="estop_topic" default="/competition/estop" />
  <arg name="command_topic" default="/$(arg robot_ns)/cmd_vel_preview" />
  <group ns="$(arg robot_ns)">
    <node pkg="rgbd_following" type="rgbd_trial_recorder.py" name="trial_recorder" output="screen" required="true">
      <rosparam command="load" file="$(arg settings)" ns="settings" />
      <param name="scenario" value="$(arg scenario)" />
      <param name="revision" value="$(arg revision)" />
      <param name="output" value="$(arg output)" />
      <param name="odom_frame" value="$(arg odom_frame)" />
      <param name="base_frame" value="$(arg base_frame)" />
      <remap from="odom" to="$(arg odom_topic)" />
      <remap from="mission" to="$(arg mission_topic)" />
      <remap from="cmd_vel_observed" to="$(arg command_topic)" />
    </node>
  </group>
  <node pkg="rosbag" type="record" name="rgbd_bag_record" output="screen"
        args="-o &quot;$(arg bag_prefix)&quot; $(arg rgb_topic) $(arg depth_topic) $(arg info_topic) $(arg odom_topic) /tf /tf_static $(arg mission_topic) $(arg estop_topic) $(arg command_topic) /$(arg robot_ns)/target_pose /$(arg robot_ns)/target_valid /$(arg robot_ns)/perception_status /$(arg robot_ns)/follow_status /$(arg robot_ns)/gate_status /$(arg robot_ns)/move_base/local_costmap/costmap" />
</launch>
