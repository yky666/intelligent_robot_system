<launch>
  <!-- Sensor drivers are started separately; this launch never controls the base. -->
  <arg name="robot_ns" default="tb3" />
  <arg name="rgb_topic" default="/camera/rgb/image_rect_color" />
  <arg name="depth_topic" default="/camera/depth_registered/image_rect" />
  <arg name="info_topic" default="/camera/rgb/camera_info" />
  <arg name="roi" default="[0.4, 0.35, 0.6, 0.65]" />
  <group ns="$(arg robot_ns)">
    <node pkg="rgbd_following" type="rgbd_probe.py" name="rgbd_probe" output="screen">
      <remap from="rgb" to="$(arg rgb_topic)" />
      <remap from="registered_depth" to="$(arg depth_topic)" />
      <remap from="camera_info" to="$(arg info_topic)" />
      <rosparam param="roi" subst_value="true">$(arg roi)</rosparam>
    </node>
  </group>
</launch>
